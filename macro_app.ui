<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1176</width>
    <height>742</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Zeron Config</string>
  </property>
  <property name="styleSheet">
   <string>
/* ============================================
   Modern Dark Theme — Single Accent
   ============================================ */

/* === Base === */
QMainWindow, QWidget {
    background-color: #121212;
    color: #E0E0E0;
    font-family: "IBM Plex Sans", "Helvetica Neue", "Segoe UI", sans-serif;
    font-size: 13px;
}

/* === Typography === */
QLabel {
    color: #E0E0E0;
    font-size: 13px;
    background-color: transparent;
}

QLabel#mainPageTitle {
    color: #ffffff;
    font-size: 22px;
    font-weight: 600;
    font-family: "Rajdhani", "IBM Plex Sans", sans-serif;
}

/* === List Widget === */
QListWidget {
    background-color: #1A1A1A;
    color: #E0E0E0;
    border: 1px solid #2A2A2A;
    border-radius: 8px;
    padding: 6px;
    font-size: 13px;
}

QListWidget::item {
    padding: 10px 8px;
    border-radius: 6px;
    margin: 2px;
}

QListWidget::item:selected {
    background-color: rgba(255, 255, 255, 0.06);
    color: #ffffff;
}

QListWidget::item:hover {
    background-color: #232323;
}

/* === Buttons (Secondary Default) === */
QPushButton {
    background-color: #2A2A2A;
    color: #E0E0E0;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #363636;
    border-color: #444444;
}

QPushButton:pressed {
    background-color: #1E1E1E;
}

/* Danger — Stop Buttons */
QPushButton#stopMacroButton {
    background-color: #2A2A2A;
    color: #E0E0E0;
    border: 1px solid #333333;
}

QPushButton#stopMacroButton:hover {
    background-color: #363636;
}

/* Webhook Toggle — disabled */
QPushButton#webhookToggleButton {
    background-color: #2A2A2A;
    color: #999999;
    border: 1px solid #333333;
}

QPushButton#webhookToggleButton:hover {
    background-color: #363636;
}

/* Webhook Toggle — enabled */
QPushButton#webhookToggleButton[enabled_state=&quot;true&quot;] {
    background-color: #E0E0E0;
    color: #ffffff;
    border: none;
}

QPushButton#webhookToggleButton[enabled_state=&quot;true&quot;]:hover {
    background-color: #34D76F;
}

/* Webhook Test */
QPushButton#webhookTestButton {
    background-color: #2A2A2A;
    color: #E0E0E0;
    border: 1px solid #333333;
}

QPushButton#webhookTestButton:hover {
    background-color: #363636;
}

/* Overlay Webhook Toggle — disabled */
QPushButton#overlayWebhookToggleButton {
    background-color: #2A2A2A;
    color: #999999;
    border: 1px solid #333333;
}

QPushButton#overlayWebhookToggleButton:hover {
    background-color: #363636;
}

/* Overlay Webhook Toggle — enabled */
QPushButton#overlayWebhookToggleButton[enabled_state=&quot;true&quot;] {
    background-color: #E0E0E0;
    color: #ffffff;
    border: none;
}

QPushButton#overlayWebhookToggleButton[enabled_state=&quot;true&quot;]:hover {
    background-color: #34D76F;
}

/* Overlay Webhook Test */
QPushButton#overlayWebhookTestButton {
    background-color: #2A2A2A;
    color: #E0E0E0;
    border: 1px solid #333333;
}

QPushButton#overlayWebhookTestButton:hover {
    background-color: #363636;
}

/* === Standard Group Box === */
QGroupBox {
    background-color: #1A1A1A;
    border: 1px solid #2A2A2A;
    border-top: 2px solid #3A3A3A;
    border-radius: 8px;
    margin-top: 16px;
    padding: 12px;
    padding-top: 14px;
    font-weight: 500;
    color: #E0E0E0;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 2px 8px;
    color: #E0E0E0;
    font-size: 13px;
    font-weight: 600;
    background-color: transparent;
}

/* Widgets inside group boxes */
QGroupBox QLabel,
QGroupBox QRadioButton,
QGroupBox QCheckBox {
    background-color: transparent;
}

/* === Overlay Page Background === */
QWidget#overlayPage {
    background-color: #0d0d0d;
    font-family: "Inter", sans-serif;
}

/* === Overlay Mode Cards === */
QGroupBox#storyModeGroup, QGroupBox#raidsModeGroup, QGroupBox#legendModeGroup,
QGroupBox#bossRushModeGroup, QGroupBox#eventsModeGroup,
QGroupBox#dungeonModeGroup {
    background-color: #111111;
    border: none;
    border-radius: 0px;
    margin-top: 0px;
    padding: 0px;
}
QGroupBox#storyModeGroup:hover, QGroupBox#raidsModeGroup:hover, QGroupBox#legendModeGroup:hover,
QGroupBox#bossRushModeGroup:hover, QGroupBox#eventsModeGroup:hover,
QGroupBox#dungeonModeGroup:hover {
    border: none;
}
QGroupBox#storyModeGroup::title, QGroupBox#raidsModeGroup::title, QGroupBox#legendModeGroup::title,
QGroupBox#bossRushModeGroup::title, QGroupBox#eventsModeGroup::title,
QGroupBox#dungeonModeGroup::title {
    width: 0px; height: 0px; padding: 0px; margin: 0px;
}

/* Overlay card combos */
QGroupBox#storyModeGroup QComboBox, QGroupBox#raidsModeGroup QComboBox,
QGroupBox#legendModeGroup QComboBox, QGroupBox#bossRushModeGroup QComboBox,
QGroupBox#eventsModeGroup QComboBox,
QGroupBox#dungeonModeGroup QComboBox {
    background-color: #0a0a0a;
    border: 1px solid #2a2a2a;
    border-radius: 0px;
    color: #ccc;
    padding: 4px 10px;
    font-size: 12px;
    combobox-popup: 0;
}
QGroupBox#storyModeGroup QComboBox QAbstractItemView,
QGroupBox#raidsModeGroup QComboBox QAbstractItemView,
QGroupBox#legendModeGroup QComboBox QAbstractItemView,
QGroupBox#bossRushModeGroup QComboBox QAbstractItemView,
QGroupBox#eventsModeGroup QComboBox QAbstractItemView,
QGroupBox#dungeonModeGroup QComboBox QAbstractItemView {
    background-color: #0a0a0a;
    color: #E0E0E0;
    selection-background-color: #1a1a1a;
    selection-color: #ffffff;
    border: 1px solid #2a2a2a;
    border-radius: 0px;
    font-size: 12px;
    padding: 2px;
    outline: 0;
}
QGroupBox#storyModeGroup QComboBox QAbstractItemView::item,
QGroupBox#raidsModeGroup QComboBox QAbstractItemView::item,
QGroupBox#legendModeGroup QComboBox QAbstractItemView::item,
QGroupBox#bossRushModeGroup QComboBox QAbstractItemView::item,
QGroupBox#eventsModeGroup QComboBox QAbstractItemView::item,
QGroupBox#dungeonModeGroup QComboBox QAbstractItemView::item {
    padding: 3px 6px;
    min-height: 16px;
    background-color: #0a0a0a;
    color: #E0E0E0;
}
QGroupBox#storyModeGroup QComboBox QAbstractItemView::item:selected,
QGroupBox#raidsModeGroup QComboBox QAbstractItemView::item:selected,
QGroupBox#legendModeGroup QComboBox QAbstractItemView::item:selected,
QGroupBox#bossRushModeGroup QComboBox QAbstractItemView::item:selected,
QGroupBox#eventsModeGroup QComboBox QAbstractItemView::item:selected,
QGroupBox#dungeonModeGroup QComboBox QAbstractItemView::item:selected {
    background-color: #1a1a1a;
    color: #ffffff;
}
QGroupBox#storyModeGroup QComboBox QFrame,
QGroupBox#raidsModeGroup QComboBox QFrame,
QGroupBox#legendModeGroup QComboBox QFrame,
QGroupBox#bossRushModeGroup QComboBox QFrame,
QGroupBox#eventsModeGroup QComboBox QFrame,
QGroupBox#dungeonModeGroup QComboBox QFrame {
    border: 1px solid #2a2a2a;
    border-radius: 0px;
    background-color: #0a0a0a;
}

/* Overlay webhook group */
QGroupBox#overlayWebhookGroup {
    background-color: #111111;
    border: 1px solid #1e1e1e;
    border-radius: 0px;
    margin-top: 0px;
    padding: 0px;
}
QGroupBox#overlayWebhookGroup::title {
    width: 0px; height: 0px; padding: 0px; margin: 0px;
}

/* Overlay webhook input */
QGroupBox#overlayWebhookGroup QLineEdit {
    background-color: #0a0a0a;
    border: 1px solid #2a2a2a;
    border-radius: 0px;
}

/* === Inputs === */
QLineEdit {
    background-color: #1E1E1E;
    color: #E0E0E0;
    border: 1px solid #2A2A2A;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 13px;
}

QLineEdit:focus {
    border: 1px solid #808080;
}

QLineEdit:hover {
    border: 1px solid #3A3A3A;
}

/* === Radio Buttons === */
QRadioButton {
    color: #E0E0E0;
    font-size: 13px;
    background-color: transparent;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QRadioButton::indicator:unchecked {
    border: 2px solid #3A3A3A;
    border-radius: 8px;
    background-color: #1E1E1E;
}

QRadioButton::indicator:unchecked:hover {
    border-color: #E0E0E0;
}

QRadioButton::indicator:checked {
    border: 2px solid #E0E0E0;
    border-radius: 8px;
    background-color: #E0E0E0;
}

/* === Checkboxes === */
QCheckBox {
    color: #E0E0E0;
    font-size: 13px;
    background-color: transparent;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked {
    border: 2px solid #3A3A3A;
    border-radius: 4px;
    background-color: #1E1E1E;
}

QCheckBox::indicator:unchecked:hover {
    border-color: #E0E0E0;
}

QCheckBox::indicator:checked {
    border: 2px solid #E0E0E0;
    border-radius: 4px;
    background-color: #E0E0E0;
}

/* === Separator Insert Buttons === */
QPushButton#insertButton {
    background-color: transparent;
    color: #444444;
    border: none;
    font-weight: 600;
    font-size: 10px;
    padding: 0px;
    border-radius: 3px;
}

QPushButton#insertButton:hover {
    color: #E0E0E0;
    background-color: #3A3A3A;
}

QPushButton#insertButton:pressed {
    color: #22C55E;
    background-color: #2A2A2A;
}

/* Cancel Insert */
QPushButton#cancelInsertButton {
    background-color: #FF4D4F;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton#cancelInsertButton:hover {
    background-color: #FF6B6B;
}


/* === Step Rows === */
QWidget#stepRow {
    background-color: transparent;
    border: none;
}

/* Number badge */
QLabel#stepNumBadge {
    background-color: #0a0a0a;
    color: #666666;
    border: 1px solid #2a2a2a;
    border-radius: 0px;
    font-family: "Inter", sans-serif;
    font-size: 11px;
    font-weight: 400;
}

/* Card container */
QWidget#stepCard {
    background-color: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 0px;
}

/* Step type label — bold tracked caps */
QLabel#stepTypeLabel {
    background-color: transparent;
    color: #FFFFFF;
    font-family: "Inter", sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2;
}

/* Detail / descriptor */
QLabel#stepDetailLabel {
    background-color: transparent;
    color: #888888;
    font-family: "Inter", sans-serif;
    font-size: 10px;
    font-weight: 400;
}

/* Value chip */
QLabel#stepValueLabel {
    background-color: transparent;
    color: #4EC9B0;
    font-family: "Inter", sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1;
}

QPushButton#inlineAddButton {
    background-color: transparent;
    color: #666666;
    border: 1px solid #2a2a2a;
    border-radius: 0px;
    font-size: 16px;
    font-weight: 300;
    padding: 0px;
    padding-bottom: 2px;
    margin: 0px;
}
QPushButton#inlineAddButton:hover {
    color: #10b981;
    border-color: #10b981;
}

QPushButton#editStepButton {
    background-color: transparent;
    color: #666666;
    border: 1px solid #2a2a2a;
    border-radius: 0px;
    font-weight: 600;
    font-size: 12px;
    padding: 0px;
    padding-bottom: 1px;
    margin: 0px;
}
QPushButton#editStepButton:hover {
    color: #E0E0E0;
    border-color: #555555;
}

QPushButton#deleteStepButton {
    background-color: transparent;
    color: #c72e2e;
    border: 1px solid #c72e2e;
    border-radius: 0px;
    font-weight: 600;
    font-size: 15px;
    padding: 0px;
    padding-bottom: 2px;
    margin: 0px;
}
QPushButton#deleteStepButton:hover {
    color: #FF4D4F;
    border-color: #FF4D4F;
    background-color: rgba(199, 46, 46, 0.1);
}

/* === Separator Widget States === */
QWidget#separator {
    background-color: transparent;
}

QWidget#separator[active=&quot;true&quot;] {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid #808080;
    border-radius: 4px;
}

/* === Group Box Highlight (Edit Mode) === */
QGroupBox[highlighted=&quot;true&quot;] {
    border: 2px solid #E0E0E0;
}

/* === Scroll Area === */
QScrollArea {
    background-color: #1A1A1A;
    border: 1px solid #2A2A2A;
    border-radius: 8px;
}

QScrollArea &gt; QWidget &gt; QWidget {
    background-color: #1A1A1A;
}

QScrollBar:vertical {
    background-color: #1A1A1A;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #333333;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #444444;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* === Status Bar === */
QStatusBar {
    background-color: #000000;
    color: #999999;
    border-top: 1px solid #2A2A2A;
    font-size: 12px;
}

/* === Menu Bar === */
QMenuBar {
    background-color: #1A1A1A;
    color: #E0E0E0;
}

/* === Combo Box === */
QComboBox {
    background-color: #1E1E1E;
    color: #E0E0E0;
    border: 1px solid #2A2A2A;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
}

QComboBox:hover {
    border-color: #3A3A3A;
}

QComboBox:focus {
    border-color: #E0E0E0;
}

QComboBox::drop-down {
    border: none;
    background-color: transparent;
    width: 25px;
}

QComboBox::down-arrow {
    image: url(references/down_arrow.svg);
    width: 10px;
    height: 6px;
}

QComboBox QAbstractItemView {
    background-color: #1A1A1A;
    color: #E0E0E0;
    selection-background-color: rgba(255, 255, 255, 0.06);
    selection-color: #ffffff;
    border: 1px solid #2A2A2A;
    border-radius: 0px;
    font-size: 10px;
    padding: 2px;
    outline: 0;
}

QComboBox QAbstractItemView::item {
    padding: 3px 6px;
    min-height: 16px;
    background-color: #1A1A1A;
    color: #E0E0E0;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #2A2A2A;
    color: #ffffff;
}

/* Remove white frame around combo popup */
QComboBox QFrame {
    border: 1px solid #2A2A2A;
    border-radius: 0px;
    background-color: #1A1A1A;
}

/* === Advanced section compact combos/inputs === */
QGroupBox#upgradeGroup QComboBox {
    font-family: "Inter", sans-serif;
    font-size: 10px;
    padding: 1px 4px;
    border-radius: 0px;
    background-color: #0a0a0a;
    border: 1px solid #1a1a1a;
    color: #E0E0E0;
    combobox-popup: 0;
}
QGroupBox#placeGroup QComboBox {
    font-size: 10px;
    padding: 1px 4px;
    border-radius: 0px;
    background-color: #0a0a0a;
    border: 1px solid #1a1a1a;
    color: #E0E0E0;
    combobox-popup: 0;
}

QGroupBox#upgradeGroup QComboBox QAbstractItemView,
QGroupBox#placeGroup QComboBox QAbstractItemView {
    background-color: #0a0a0a;
    color: #E0E0E0;
    selection-background-color: #1a1a1a;
    selection-color: #ffffff;
    border: 1px solid #2a2a2a;
    border-radius: 0px;
    font-size: 10px;
    padding: 2px;
    outline: 0;
}

QGroupBox#advancedClickGroup QComboBox,
QGroupBox#advancedKeyGroup QComboBox {
    font-size: 10px;
    padding: 1px 4px;
    border-radius: 4px;
}

QGroupBox#upgradeGroup QLineEdit,
QGroupBox#placeGroup QLineEdit {
    font-family: "Menlo", "SF Mono", monospace;
    font-size: 10px;
    padding: 1px 4px;
    border-radius: 0px;
    background-color: #0a0a0a;
    border: 1px solid #1a1a1a;
    color: #E0E0E0;
}

QGroupBox#advancedWaitGroup QLineEdit {
    font-family: "Menlo", "SF Mono", monospace;
    font-size: 10px;
    padding: 1px 4px;
    border-radius: 0px;
    background-color: #0a0a0a;
    border: 1px solid #1a1a1a;
    color: #E0E0E0;
}

QGroupBox#advancedClickGroup QLineEdit,
QGroupBox#advancedKeyGroup QLineEdit {
    font-family: "Menlo", "SF Mono", monospace;
    font-size: 10px;
    padding: 1px 4px;
    border-radius: 0px;
    background-color: #0a0a0a;
    border: 1px solid #1a1a1a;
    color: #E0E0E0;
}

QGroupBox#advancedKeyGroup QRadioButton,
QGroupBox#advancedClickGroup QRadioButton {
    font-family: "Inter", sans-serif;
    font-size: 10px;
    spacing: 6px;
}
QGroupBox#advancedKeyGroup QRadioButton::indicator,
QGroupBox#advancedClickGroup QRadioButton::indicator {
    width: 12px;
    height: 12px;
}
QGroupBox#advancedKeyGroup QRadioButton::indicator:unchecked,
QGroupBox#advancedClickGroup QRadioButton::indicator:unchecked {
    border: 1px solid #3A3A3A;
    border-radius: 0px;
    background-color: #0a0a0a;
}
QGroupBox#advancedKeyGroup QRadioButton::indicator:unchecked:hover,
QGroupBox#advancedClickGroup QRadioButton::indicator:unchecked:hover {
    border-color: #10b981;
}
QGroupBox#advancedKeyGroup QRadioButton::indicator:checked,
QGroupBox#advancedClickGroup QRadioButton::indicator:checked {
    border: 1px solid #10b981;
    border-radius: 0px;
    background-color: #10b981;
    image: url(references/checkmark.svg);
}

/* === Wait group radio buttons (redesigned) === */
QGroupBox#advancedWaitGroup QRadioButton {
    font-family: "Inter", sans-serif;
    font-size: 10px;
    spacing: 6px;
}

QGroupBox#advancedWaitGroup QRadioButton::indicator {
    width: 12px;
    height: 12px;
}

QGroupBox#advancedWaitGroup QRadioButton::indicator:unchecked {
    border: 1px solid #3A3A3A;
    border-radius: 0px;
    background-color: #0a0a0a;
}

QGroupBox#advancedWaitGroup QRadioButton::indicator:unchecked:hover {
    border-color: #10b981;
}

QGroupBox#advancedWaitGroup QRadioButton::indicator:checked {
    border: 1px solid #10b981;
    border-radius: 0px;
    background-color: #10b981;
    image: url(references/checkmark.svg);
}


QGroupBox#unitSelectionGroup QLineEdit {
    font-family: "Inter", sans-serif;
    font-size: 12px;
    padding: 4px 8px;
    border-radius: 0px;
    background-color: #0a0a0a;
    border: 1px solid #2a2a2a;
    color: #E0E0E0;
}

QGroupBox#upgradeGroup QCheckBox {
    font-family: "Inter", sans-serif;
    font-size: 10px;
    spacing: 6px;
}
QGroupBox#placeGroup QCheckBox {
    font-size: 10px;
    spacing: 6px;
}

QGroupBox#upgradeGroup QCheckBox::indicator,
QGroupBox#placeGroup QCheckBox::indicator {
    width: 12px;
    height: 12px;
}

QGroupBox#upgradeGroup QCheckBox::indicator:unchecked,
QGroupBox#placeGroup QCheckBox::indicator:unchecked {
    border: 1px solid #3A3A3A;
    border-radius: 0px;
    background-color: #0a0a0a;
}

QGroupBox#upgradeGroup QCheckBox::indicator:unchecked:hover,
QGroupBox#placeGroup QCheckBox::indicator:unchecked:hover {
    border-color: #10b981;
}

QGroupBox#upgradeGroup QCheckBox::indicator:checked,
QGroupBox#placeGroup QCheckBox::indicator:checked {
    border: 1px solid #10b981;
    border-radius: 0px;
    background-color: #10b981;
    image: url(references/checkmark.svg);
}

/* === Unit Group Boxes === */
QGroupBox#unit1Group, QGroupBox#unit2Group, QGroupBox#unit3Group,
QGroupBox#unit4Group, QGroupBox#unit5Group, QGroupBox#unit6Group {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    margin-top: 0px;
    padding: 0px;
}

QGroupBox#unit1Group::title, QGroupBox#unit2Group::title, QGroupBox#unit3Group::title,
QGroupBox#unit4Group::title, QGroupBox#unit5Group::title, QGroupBox#unit6Group::title {
    width: 0px;
    height: 0px;
}

/* === Upgrade Section === */
QGroupBox#upgradeGroup {
    background-color: #000000;
    border: 1px solid #2a2a2a;
    border-radius: 0px;
    margin-top: 0px;
    padding: 0px;
}

QGroupBox#upgradeGroup::title {
    width: 0px;
    height: 0px;
}

/* === Place Section === */
QGroupBox#placeGroup {
    background-color: #000000;
    border: 1px solid #2a2a2a;
    border-radius: 0px;
    margin-top: 0px;
    padding: 0px;
}

QGroupBox#placeGroup::title {
    width: 0px;
    height: 0px;
}

/* === Group Header Labels === */
QLabel#clickHeaderLabel,
QLabel#keyHeaderLabel {
    background-color: transparent;
    color: #888888;
    font-family: "Inter", sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2;
    padding-left: 10px;
    border-bottom: 1px solid #2a2a2a;
    border-radius: 0px;
}
QLabel#settingsHeaderLabel {
    background-color: transparent;
    color: #888888;
    font-family: "Inter", sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2;
    padding-left: 10px;
    border-bottom: 1px solid #2a2a2a;
    border-radius: 0px;
}

QLabel#waitHeaderLabel {
    background-color: transparent;
    color: #888888;
    font-family: "Inter", sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2;
    padding-left: 10px;
    border-bottom: 1px solid #2a2a2a;
    border-radius: 0px;
}

/* === Upgrade/Place/Units Header Labels (dark redesign) === */
QLabel#upgradeHeaderLabel,
QLabel#unitSelectionHeaderLabel {
    background-color: transparent;
    color: #888888;
    font-family: "Inter", sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2;
    padding-left: 10px;
    border-bottom: 1px solid #2a2a2a;
    border-radius: 0px;
}
QLabel#placeHeaderLabel {
    background-color: transparent;
    color: #888888;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2;
    padding-left: 10px;
    border-bottom: 1px solid #2a2a2a;
    border-radius: 0px;
}

/* === Unit N: labels (inline with inputs) === */
QLabel#unit1HeaderLabel, QLabel#unit2HeaderLabel, QLabel#unit3HeaderLabel,
QLabel#unit4HeaderLabel, QLabel#unit5HeaderLabel, QLabel#unit6HeaderLabel {
    background-color: transparent;
    color: #888888;
    font-family: "Inter", sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0;
    padding-left: 0px;
    border-radius: 0px;
}

/* === All labels in upgrade group use Inter === */
QGroupBox#upgradeGroup QLabel {
    font-family: "Inter", sans-serif;
}

/* === Column header labels in upgrade/place groups === */
QLabel#upgradeUnitLabel,
QLabel#upgradePlacementLabel,
QLabel#upgradeCountLabel {
    color: #555555;
    font-family: "Inter", sans-serif;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1;
    background-color: transparent;
}
QLabel#placeUnitLabel,
QLabel#placeXLabel,
QLabel#placeYLabel,
QLabel#placementColHeaderLabel {
    color: #555555;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1;
    background-color: transparent;
}

/* === Add Upgrade Step button (green, full-width) === */
QPushButton#addUpgradeStepButton {
    background-color: #10b981;
    color: #000000;
    font-family: "Inter", sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2;
    border: none;
    border-radius: 0px;
}
QPushButton#addUpgradeStepButton:hover {
    background-color: #0ea472;
}
QPushButton#addUpgradeStepButton:pressed {
    background-color: #0d9668;
}

/* === Add Place Step button (green) === */
QPushButton#addPlaceStepButton {
    background-color: #10b981;
    color: #000000;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1;
    border: none;
    border-radius: 0px;
}
QPushButton#addPlaceStepButton:hover {
    background-color: #0ea472;
}

/* === Record Place Click button (dark secondary) === */
QPushButton#recordPlaceClickButton {
    background-color: #0a0a0a;
    color: #C0C0C0;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1;
    border: 1px solid #333333;
    border-radius: 0px;
}
QPushButton#recordPlaceClickButton:hover {
    background-color: #2E2E2E;
    color: #E0E0E0;
    border-color: #444444;
}

/* === Add Wait Step button (green, redesigned) === */
QPushButton#addAdvancedWaitButton {
    background-color: #10b981;
    color: #000000;
    font-family: "Inter", sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2;
    border: none;
    border-radius: 0px;
}
QPushButton#addAdvancedWaitButton:hover {
    background-color: #0ea472;
}
QPushButton#addAdvancedWaitButton:pressed {
    background-color: #0d9668;
}

/* === Click / Key add buttons (green) === */
QPushButton#addAdvancedClickButton,
QPushButton#addAdvancedKeyButton {
    background-color: #10b981;
    color: #000000;
    font-family: "Inter", "IBM Plex Sans", sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2;
    border: none;
    border-radius: 0px;
}
QPushButton#addAdvancedClickButton:hover,
QPushButton#addAdvancedKeyButton:hover {
    background-color: #0ea472;
}
QPushButton#addAdvancedClickButton:pressed,
QPushButton#addAdvancedKeyButton:pressed {
    background-color: #0d9668;
}
/* === Record Click button (dark) === */
QPushButton#advRecordClickButton {
    background-color: #1a1a1a;
    color: #C0C0C0;
    font-family: "Inter", "IBM Plex Sans", sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1;
    border: 1px solid #333333;
    border-radius: 0px;
}
QPushButton#advRecordClickButton:hover {
    background-color: #2E2E2E;
    color: #E0E0E0;
    border-color: #444444;
}

/* === Save / Clear / Back buttons (Advanced Create) === */
QPushButton#advancedSaveButton {
    background-color: #10b981;
    color: #000000;
    font-family: "Inter", sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2;
    border: none;
    border-radius: 0px;
}
QPushButton#advancedSaveButton:hover {
    background-color: #0ea472;
}
QPushButton#advancedSaveButton:pressed {
    background-color: #0d9668;
}
QPushButton#advancedClearButton {
    background-color: #0a0a0a;
    color: #888888;
    font-family: "Inter", sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2;
    border: 1px solid #2a2a2a;
    border-radius: 0px;
}
QPushButton#advancedClearButton:hover {
    background-color: #1a1a1a;
    color: #CCCCCC;
    border-color: #444444;
}
QPushButton#advBackButton {
    background-color: #0a0a0a;
    color: #888888;
    font-family: "Inter", sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2;
    border: 1px solid #2a2a2a;
    border-radius: 0px;
}
QPushButton#advBackButton:hover {
    background-color: #1a1a1a;
    color: #CCCCCC;
    border-color: #444444;
}

/* === Unit Selection === */
QGroupBox#unitSelectionGroup {
    background-color: #000000;
    border: 1px solid #2a2a2a;
    border-radius: 0px;
    margin-top: 0px;
    padding: 0px;
}
QGroupBox#unitSelectionGroup::title { width: 0px; height: 0px; }

/* === Advanced Steps Scroll Area === */
QScrollArea#advancedStepsScrollArea {
    background-color: #0a0a0a;
    border: 1px solid #2a2a2a;
    border-radius: 0px;
}

/* === Wait Section === */
QGroupBox#advancedWaitGroup {
    background-color: #000000;
    border: 1px solid #2a2a2a;
    border-radius: 0px;
    margin-top: 0px;
    padding: 0px;
}
QGroupBox#advancedWaitGroup::title { width: 0px; height: 0px; }

/* === Click Group (Raw Steps) === */
QGroupBox#advancedClickGroup {
    background-color: #000000;
    border: 1px solid #2a2a2a;
    border-radius: 0px;
    margin-top: 0px;
    padding: 0px;
}
QGroupBox#advancedClickGroup::title { width: 0px; height: 0px; }

/* === Key Group (Raw Steps) === */
QGroupBox#advancedKeyGroup {
    background-color: #000000;
    border: 1px solid #2a2a2a;
    border-radius: 0px;
    margin-top: 0px;
    padding: 0px;
}
QGroupBox#advancedKeyGroup::title { width: 0px; height: 0px; }

